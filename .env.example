# -----------------------------------------------------------------------------
# Petire — variáveis de ambiente
#
# Copie para .env.local. Para desenvolvimento local, `npm run db:start` imprime
# a URL e as chaves do stack Supabase local.
# -----------------------------------------------------------------------------

# URL do projeto Supabase.
# Local:      http://127.0.0.1:54321
# Produção:   https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon/publishable. Vai para o browser — é pública por design.
# Toda a proteção real vem das políticas de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role. IGNORA RLS. Nunca prefixar com NEXT_PUBLIC_, nunca
# importar em Client Component. Usada só pelo painel /admin e por /api/events.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, usada em metadata, sitemap e links absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp do Petire, onde o lojista pede ajuda pelo rodapé do painel.
# Só dígitos, com código do país: 5532988887777. Vazio esconde o rodapé —
# em desenvolvimento não há para quem escrever.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
